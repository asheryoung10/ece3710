	vga_vs,
	vga_sync_n,
	vga_red,
	vga_green,
	vga_blue);
input 	systemClock50MHz;
input 	[9:0] switches;
output 	[9:0] leds;
input 	[3:0] push_buttons;
output 	[6:0] hex0;
output 	[6:0] hex1;
