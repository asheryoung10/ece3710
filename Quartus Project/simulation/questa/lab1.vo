`timescale 1 ps/ 1 ps

module doodle_jump (
	systemClock50MHz,
	switches,
	leds,
	push_buttons,
	hex0,
	hex1,
	hex2,
	hex3,
	hex4,
	hex5,
	i2c_clock,
