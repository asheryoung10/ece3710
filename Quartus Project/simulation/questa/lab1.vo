`timescale 1 ps/ 1 ps

module cpu (
	clock,
	reset,
	instructionRegisterContentsOutput,
	programCounterContentsOutput,
	programStateRegisterContentsOutput,
	aluResultOutput,
	aluFlagsOutput,
	controlUnitState,
	controlUnitNextState,
	memoryWriteEnable,
	memoryReadWriteAddress,
	registerFileContentsB,
	memoryContents,
	leftButton,
	rightButton,
	jumpButton,
	vsync,
	R3);
input 	clock;
input 	reset;
output 	[15:0] instructionRegisterContentsOutput;
output 	[15:0] programCounterContentsOutput;
output 	[15:0] programStateRegisterContentsOutput;
