`timescale 1ns / 1ps
module playerMemory (
    input  wire       clk50,
    input  wire [9:0] playerX, // sprite position X (unused for placeholder)
    input  wire [9:0] playerY, // sprite position Y (unused for placeholder)
    input  wire [9:0] pixelX,  // current pixel being fetched
    input  wire [9:0] pixelY,
    input  wire [3:0] playerAnimationIndex,
    output reg  [7:0] playerPixelR,
    output reg  [7:0] playerPixelG,
    output reg  [7:0] playerPixelB
);

reg [7:0] r_next, g_next, b_next;

// Simple 32x32 square sprite
always @(posedge clk50) begin
    if ((pixelX % 64 < 32) && (pixelY % 64 < 32)) begin
        // Change color based on animation index for testing
        r_next <= 8'd255; // Red
        g_next <= (playerAnimationIndex * 16); // Vary green
        b_next <= 8'd0;   // Blue
    end else begin
        r_next <= 8'd0;
        g_next <= 8'd0;
        b_next <= 8'd0;   // Transparent (black)
    end
end

// Output one cycle later (simulate memory latency)
always @(posedge clk50) begin
    playerPixelR <= r_next;
    playerPixelG <= g_next;
    playerPixelB <= b_next;
end

endmodule
