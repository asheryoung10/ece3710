module sharedMemory
#(
    parameter DATA_WIDTH = 16,
    parameter INIT_FILE = "init_mem.text"
)
(
    input clock,
    input writeEnable,
    input [15:0] writeData,
    input [15:0] readWriteAddress,
    output reg [15:0] contents,

    input [9:0] vgaX,
    input [9:0] vgaY,
    output reg [7:0] r,
    output reg [7:0] g,
    output reg [7:0] b
);
reg [DATA_WIDTH-1:0] ram[0:1023];

always @(posedge clock) begin

end


endmodule
