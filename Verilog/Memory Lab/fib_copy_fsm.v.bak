//======================================================
// fib_copy_fsm.v
// Copies memory[0..15] -> memory[1024..1039]
//======================================================

module fib_copy_fsm (
    input  clk,
    input  rst,

    // BRAM Port A
    output reg [10:0] addr_a,   // 11-bit for 1024+
    output reg [15:0] din_a,
    output reg        en_a,
    output reg        we_a,
    input      [15:0] dout_a,

    output reg done
);

    // FSM states
    localparam IDLE      = 3'd0;
    localparam READ      = 3'd1;
    localparam READ_WAIT = 3'd2;
    localparam WRITE     = 3'd3;
    localparam NEXT      = 3'd4;
    localparam FINISH    = 3'd5;

    reg [2:0] state;
    reg [4:0] index;        // 0..15
    reg [15:0] buffer;      // holds read data

    always @(posedge clk) begin
        if (rst) begin
            state  <= IDLE;
            index  <= 5'd0;
            en_a   <= 1'b0;
